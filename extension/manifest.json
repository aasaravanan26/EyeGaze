{
  "manifest_version": 3,
  "name": "Glance (proof of concept)",
  "version": "0.0.1",
  "description": "Drive Netflix from a side panel of big buttons.",
  "permissions": ["sidePanel", "storage"],
  "host_permissions": ["https://www.netflix.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Glance"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.netflix.com/*"],
      "js": ["adapters/netflix.js"]
    }
  ]
}
